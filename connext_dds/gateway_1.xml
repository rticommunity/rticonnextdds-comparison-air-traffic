<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://community.rti.com/schema/current/rti_routing_service.xsd">

    <!--
    Run the gateway as follows:

    <connext installation>/bin/rtiroutingservice -cfgFile <this_file>.xml -cfgName gateway_1_gateway
    -->

    
    <qos_library name="gateway_1_gateway_qos">
        <qos_profile name="cloud">
            <base_name>
                <element>BuiltinQosSnippetLib::Transport.UDP.WAN</element>
                <element>BuiltinQosSnippetLib::Optimization.Discovery.Common</element>
                <element>BuiltinQosSnippetLib::QosPolicy.Durability.Transient</element>
                <element>BuiltinQosSnippetLib::QosPolicy.Reliability.Reliable</element>
                
            </base_name>

            <participant_qos>
                <property>
                    <value>
                        <element>
                            <name>dds.domain_participant.domain_tag</name>
                            <value>cdb-gerardo-demo-56309e2a741b4444a7398af4a96dbc1c</value>
                        </element>
                        
                    </value>
                </property>
                <transport_builtin>
                    <mask>UDPv4_WAN</mask>
                    <udpv4_wan>
                        <comm_ports>
                            <default>
                                <host>7777</host>
                            </default>
                        </comm_ports>
                    </udpv4_wan>
                </transport_builtin>
                <discovery>
                    <initial_peers>
                        <element>udpv4_wan://52.32.222.188:7015</element>
                    </initial_peers>
                </discovery>
                <resource_limits>
                    <contentfilter_property_max_length>
                        65535
                    </contentfilter_property_max_length>
                </resource_limits>
            </participant_qos>
            <datawriter_qos>
                <durability_service>
                    <history_kind>KEEP_LAST_HISTORY_QOS</history_kind>
                    <history_depth>1</history_depth>
                </durability_service>
                <history>
                    <kind>KEEP_ALL_HISTORY_QOS</kind>
                </history>
                <durability>
                    <writer_depth>1</writer_depth>
                </durability>
                
                <protocol>
                    <rtps_reliable_writer>
                        <fast_heartbeat_period>
                            <sec>0</sec>
                            <nanosec>200000000</nanosec>
                        </fast_heartbeat_period>
                        <late_joiner_heartbeat_period>
                            <sec>0</sec>
                            <nanosec>200000000</nanosec>
                        </late_joiner_heartbeat_period>
                        <heartbeat_period>
                            <sec>0</sec>
                            <nanosec>200000000</nanosec>
                        </heartbeat_period>
                        <max_heartbeat_retries>150</max_heartbeat_retries>
                        <max_nack_response_delay>
                            <sec>0</sec>
                            <nanosec>0</nanosec>
                        </max_nack_response_delay>
                        <nack_suppression_duration>
                            <sec>0</sec>
                            <nanosec>10000000</nanosec>
                        </nack_suppression_duration>
                        <min_nack_response_delay>
                            <sec>0</sec>
                            <nanosec>0</nanosec>
                        </min_nack_response_delay>
                    </rtps_reliable_writer>
                </protocol>

            </datawriter_qos>
            <datareader_qos>
                <history>
                    <kind>KEEP_ALL_HISTORY_QOS</kind>
                </history>
                
                <protocol>
                    <rtps_reliable_reader>
                        <max_heartbeat_response_delay>
                            <sec>0</sec>
                            <nanosec>0</nanosec>
                        </max_heartbeat_response_delay>
                        <min_heartbeat_response_delay>
                            <sec>0</sec>
                            <nanosec>0</nanosec>
                        </min_heartbeat_response_delay>
                        <receive_window_size>
                            16384
                        </receive_window_size>
                    </rtps_reliable_reader>
                </protocol>

            </datareader_qos>
        </qos_profile>

        <qos_profile name="edge">
            <base_name>
                <element>BuiltinQosSnippetLib::QosPolicy.Reliability.Reliable</element>
                <element>BuiltinQosSnippetLib::QosPolicy.History.KeepAll</element>
            </base_name>
        </qos_profile>
    </qos_library>

    <routing_service name="gateway_1_gateway">
        <administration>
            <enabled>false</enabled>
        </administration>
        <monitoring>
            <enabled>false</enabled>
        </monitoring>
        <domain_route name="etc">
            <!-- Default cloud participant -->
            <participant name="cloud">
                <domain_id>100</domain_id>
                <participant_qos base_name="gateway_1_gateway_qos::cloud" />
            </participant>

            <!-- Edge participants -->
            <participant name="edge_participant_domain_0">
                <domain_id>0</domain_id>
                <participant_qos base_name="gateway_1_gateway_qos::edge" />
            </participant>

            <session name="default_session">
                <auto_topic_route name="route_0_all_edge_to_cloud">
                    <publish_with_original_info>true</publish_with_original_info>
                    <publish_with_original_timestamp>true</publish_with_original_timestamp>
                    <input participant="edge_participant_domain_0">
                        <allow_topic_name_filter>*</allow_topic_name_filter>
                        <allow_registered_type_name_filter>*</allow_registered_type_name_filter>
                        <deny_topic_name_filter>rti/*,RTI::PersistenceService::DurableSubscription,DDSVirtualSubscription</deny_topic_name_filter>
                        <creation_mode>ON_DOMAIN_MATCH</creation_mode>
                        <datareader_qos base_name="gateway_1_gateway_qos::edge" />
                    </input>
                    <output participant="cloud">
                        <allow_topic_name_filter>*</allow_topic_name_filter>
                        <allow_registered_type_name_filter>*</allow_registered_type_name_filter>
                        <deny_topic_name_filter>rti/*,RTI::PersistenceService::DurableSubscription,DDSVirtualSubscription</deny_topic_name_filter>
                        <creation_mode>ON_ROUTE_MATCH</creation_mode>
                        
                        <datawriter_qos base_name="gateway_1_gateway_qos::cloud">
                            <durability>
                                <kind>TRANSIENT_DURABILITY_QOS</kind>
                                <writer_depth>1</writer_depth>
                            </durability>
                            <durability_service>
                                <history_kind>KEEP_LAST_HISTORY_QOS</history_kind>
                                <history_depth>1</history_depth>
                            </durability_service>
                        </datawriter_qos>
                
                    </output>
                </auto_topic_route>


                <auto_topic_route name="route_0_all_cloud_to_edge">
                    <publish_with_original_info>true</publish_with_original_info>
                    <publish_with_original_timestamp>true</publish_with_original_timestamp>
                    <input participant="cloud">
                        <allow_topic_name_filter>*</allow_topic_name_filter>
                        <allow_registered_type_name_filter>*</allow_registered_type_name_filter>
                        <deny_topic_name_filter>rti/*,RTI::PersistenceService::DurableSubscription,DDSVirtualSubscription</deny_topic_name_filter>
                        <creation_mode>ON_DOMAIN_AND_ROUTE_MATCH</creation_mode>
                        <datareader_qos base_name="gateway_1_gateway_qos::cloud" />
                    </input>
                    <output participant="edge_participant_domain_0">
                        <allow_topic_name_filter>*</allow_topic_name_filter>
                        <allow_registered_type_name_filter>*</allow_registered_type_name_filter>
                        <deny_topic_name_filter>rti/*,RTI::PersistenceService::DurableSubscription,DDSVirtualSubscription</deny_topic_name_filter>
                        <creation_mode>ON_DOMAIN_AND_ROUTE_MATCH</creation_mode>
                        
                        <datawriter_qos base_name="gateway_1_gateway_qos::edge">
                            <durability>
                                <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
                                <writer_depth>1</writer_depth>
                            </durability>
                        </datawriter_qos>
                
                    </output>
                </auto_topic_route>

            </session>
        </domain_route>
    </routing_service>
</dds>
